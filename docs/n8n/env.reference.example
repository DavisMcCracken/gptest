# Copy to /etc/rmhck/n8n/n8n.env and /etc/rmhck/n8n/compose.env on the Fedora host.
# chmod 600; never commit real values.
#
# Gate A3 required before filling integration-related values.

# --- compose.env (used by docker compose for Postgres) ---
POSTGRES_PASSWORD=generate_with_openssl_rand_hex_32

# --- n8n.env ---
N8N_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
N8N_HOST=n8n.internal.rmhck.local
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.internal.rmhck.local/

# Integration credentials belong in the n8n credential vault (UI), not here,
# unless a specific node requires env vars. Examples for documentation only:
# DONORPERFECT_API_KEY=
# FUNDRAISEUP_WEBHOOK_SECRET=
# ONECAUSE_API_KEY=
# SLACK_BOT_TOKEN=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
